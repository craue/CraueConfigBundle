<!--
	TODO remove as soon as Symfony >= 8 is required ("Since symfony/dependency-injection 7.4: XML configuration format is deprecated.")
-->
<container
		xmlns="http://symfony.com/schema/dic/services"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
	<services>
		<service id="Craue\ConfigBundle\Controller\SettingsController" class="Craue\ConfigBundle\Controller\SettingsController">
			<call method="setContainer">
				<argument type="service" id="service_container" />
			</call>
			<bind key="$cache" type="service" id="craue_config_cache" />
			<tag name="controller.service_arguments"/>
		</service>
	</services>
</container>
